# YouthForge Environment Variables Configuration
# Copy this file to .env.local for local overrides. NEVER commit secrets to git.

# Runtime / Execution Mode
# Values: "live" (uses live external APIs) or "fixture" (deterministic, honest cached evidence)
YOUTHFORGE_EXECUTION_MODE="fixture"

# LLM Providers (Optional for demo/fixture mode; required for live mode)
# Supported: "openai" | "anthropic" | "gemini"
LLM_PROVIDER="openai"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Research Providers (Optional for demo/fixture mode)
# Supported: Valyu API (primary) or Tavily API (fallback)
VALYU_API_KEY=""
TAVILY_API_KEY=""

# Attestation & Proof Layer (Optional: Sepolia testnet)
ETHEREUM_RPC_URL="https://rpc.sepolia.org"
EAS_CONTRACT_ADDRESS="0xC2679fBD37d54388Ce493F1DB75320D236e1815e"
ATTESTATION_MODE="offchain_hash" # "offchain_hash" or "eas_testnet"

# Application Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEMO_MODE="true"
